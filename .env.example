# Copy this file to .env and fill in real values. NEVER commit .env to git.

# PostgreSQL connection string (used by Prisma)
# Get a free one from: https://neon.tech, https://supabase.com, or https://railway.app
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Secret used to sign JWTs - make this long and random in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# How long a login token stays valid
JWT_EXPIRES_IN=7d

# Server port
PORT=5000
